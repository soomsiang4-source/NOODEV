# ==========================================
# LINE OA & GEMINI AI CONFIGURATION
# ==========================================

# 1. Google Gemini API Key (Required for AI Reasoning & Chat)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. LINE Messaging API Credentials (From LINE Developers Console)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# 3. Server Port (Default: 3000)
PORT=3000
